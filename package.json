{
  "name": "brevity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && npm run lint:architecture",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "RUN_LIVE_AI_EVALS=1 vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:challenges": "tsx scripts/generate-challenges.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.40",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2"
